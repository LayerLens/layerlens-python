#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

if ! command -v uv >/dev/null 2>&1; then
  echo "uv is required: https://docs.astral.sh/uv/getting-started/installation/" >&2
  exit 1
fi

echo "==> Installing Python dependencies from uv.lock…"

# Installs the Python from .python-version, then exactly uv.lock: every extra plus
# the dev group. --locked fails instead of re-locking when uv.lock is stale against
# pyproject.toml (run `uv lock` first). See CONTRIBUTING.md > "Dependencies and the lock".
uv sync --locked --all-extras
